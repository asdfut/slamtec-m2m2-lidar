diff --git a/src/logger.cpp b/src/logger.cpp
index 96ecbb9..18cd4e3 100644
--- a/src/logger.cpp
+++ b/src/logger.cpp
@@ -52,7 +52,12 @@ class RosLogSink : public spdlog::sinks::base_sink <Mutex>
     protected:
     void sink_it_(const spdlog::details::log_msg& msg) override
     {
-        static rcutils_log_location_t __log_loc = { msg.source.funcname, msg.source.filename, static_cast<size_t>(msg.source.line) };
+        // spdlog leaves funcname/filename null when no source location is recorded, and the
+        // rosout handler calls strlen() on them, so fall back to empty strings.
+        rcutils_log_location_t __log_loc = {
+            msg.source.funcname ? msg.source.funcname : "",
+            msg.source.filename ? msg.source.filename : "",
+            static_cast<size_t>(msg.source.line) };
         if (msg.level == spdlog::level::info) {
             rcutils_log(&__log_loc, RCUTILS_LOG_SEVERITY_INFO, logger_.get_name(), "%s", fmt::to_string(msg.payload).c_str());
         }
